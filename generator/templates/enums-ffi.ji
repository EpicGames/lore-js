{% import "utils.ji" as utils %}

import koffi from "koffi";

{#

Export Typescript enums and the corresponding Koffi aliases, that map them to int32_t in C structs.

For instance, for the `enum lore_branch_location_t`
    typedef enum lore_branch_location_t {
        LORE_BRANCH_LOCATION_LOCAL = 0,
        LORE_BRANCH_LOCATION_REMOTE = 1,
    } lore_branch_location_t;

the result is:

    export const LoreBranchLocationDef = koffi.alias(
        "LoreBranchLocation",
        "int32_t"
    );

Enums are aliased to the signed `int32_t` rather than `uint32_t` so that negative
enumerators (such as `LORE_ERROR_CODE_INTERNAL = -1`) round-trip instead of
decoding as a large positive number.
#}
{% for enum_name, enum_values in symbols.enums.items() %}
    export const {{pascal_case(enum_name.removesuffix("_t"))}}Def = koffi.alias('{{pascal_case(enum_name.removesuffix("_t"))}}', 'int32_t');
{% endfor %}

export const loadEnumsFFI = () => {};
